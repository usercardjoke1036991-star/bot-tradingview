# Nunca subas el archivo .env real al repositorio.
API_KEY=tu_api_key_de_binance
API_SECRET=tu_api_secret_de_binance
WEBHOOK_SECRET=reemplaza_esto_por_un_token_aleatorio_de_32_caracteres_o_mas

# spot: compra/vende el activo; future: contratos perpetuos USD-M.
BINANCE_MARKET_TYPE=spot

# true únicamente mientras pruebas con el entorno sandbox/testnet de Binance.
BINANCE_SANDBOX=false

# Límite duro por orden. Ajusta este importe a tu gestión de riesgo.
MAX_ORDER_NOTIONAL_USDT=1000

# Lista opcional, separada por comas. Vacía permite todos los pares disponibles.
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT

DEDUPLICATION_TTL_SECONDS=86400
LOG_LEVEL=INFO
